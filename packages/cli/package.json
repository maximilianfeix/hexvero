{
  "name": "hexvero",
  "version": "0.3.0",
  "description": "The first look at a binary or app bundle: static, execution-free analysis with evidence. CLI, MCP server and web UI.",
  "keywords": [
    "apk",
    "asar",
    "binary-analysis",
    "cli",
    "dotnet",
    "electron",
    "elf",
    "evm",
    "go",
    "mach-o",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pe",
    "reverse-engineering",
    "sqlite",
    "static-analysis",
    "wasm"
  ],
  "homepage": "https://hexvero.dev",
  "bugs": {
    "url": "https://github.com/maximilianfeix/hexvero/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/hexvero.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hexvero": "bin/hexvero.js"
  },
  "files": [
    "dist",
    "bin",
    "ui",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"require('node:fs').cpSync('../../skills','./skills',{recursive:true})\""
  },
  "dependencies": {
    "@hexvero/core": "0.3.0",
    "@hexvero/mcp": "0.3.0",
    "@hexvero/server": "0.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
