{
  "name": "hexvero",
  "version": "0.10.0",
  "description": "Electron release diff for security review and audit: compare two builds (app.asar, .app, install directory, release ZIP) and see what changed in IPC, contextBridge, window settings, network hosts and storage, with file and line. CI check with SARIF, MCP server, local web UI. Reads files only, never runs the app.",
  "keywords": [
    "apk",
    "asar",
    "audit",
    "binary-analysis",
    "cli",
    "contextbridge",
    "diff",
    "dotnet",
    "electron",
    "electron-security",
    "elf",
    "evm",
    "go",
    "ipc",
    "mach-o",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pe",
    "release-diff",
    "reverse-engineering",
    "sarif",
    "security-review",
    "sqlite",
    "static-analysis",
    "wasm"
  ],
  "homepage": "https://github.com/maximilianfeix/hexvero#readme",
  "bugs": {
    "url": "https://github.com/maximilianfeix/hexvero/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/hexvero.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hexvero": "bin/hexvero.js"
  },
  "files": [
    "dist",
    "bin",
    "ui",
    "skills",
    "examples"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"const fs=require('node:fs');fs.cpSync('../../skills','./skills',{recursive:true});fs.mkdirSync('./examples',{recursive:true});for(const v of ['1.4.0','1.5.0'])fs.copyFileSync('../../examples/notesdesk-'+v+'.asar','./examples/notesdesk-'+v+'.asar');fs.copyFileSync('../../examples/policy.json','./examples/policy.json')\""
  },
  "dependencies": {
    "@hexvero/core": "0.10.0",
    "@hexvero/mcp": "0.10.0",
    "@hexvero/server": "0.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "mcpName": "io.github.maximilianfeix/hexvero"
}
