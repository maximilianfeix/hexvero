{
  "name": "hexvero",
  "version": "0.9.2",
  "description": "Know what changed inside your app: inspect Electron apps and binaries, trace findings to file and line, compare releases. Locally, without running the target. CLI, MCP server and web UI.",
  "keywords": [
    "apk",
    "asar",
    "binary-analysis",
    "cli",
    "dotnet",
    "electron",
    "elf",
    "evm",
    "go",
    "mach-o",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pe",
    "reverse-engineering",
    "sqlite",
    "static-analysis",
    "wasm"
  ],
  "homepage": "https://github.com/maximilianfeix/hexvero#readme",
  "bugs": {
    "url": "https://github.com/maximilianfeix/hexvero/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/hexvero.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hexvero": "bin/hexvero.js"
  },
  "files": [
    "dist",
    "bin",
    "ui",
    "skills",
    "examples"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"const fs=require('node:fs');fs.cpSync('../../skills','./skills',{recursive:true});fs.mkdirSync('./examples',{recursive:true});for(const v of ['1.4.0','1.5.0'])fs.copyFileSync('../../examples/notesdesk-'+v+'.asar','./examples/notesdesk-'+v+'.asar');fs.copyFileSync('../../examples/policy.json','./examples/policy.json')\""
  },
  "dependencies": {
    "@hexvero/core": "0.9.2",
    "@hexvero/mcp": "0.9.2",
    "@hexvero/server": "0.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "mcpName": "io.github.maximilianfeix/hexvero"
}
