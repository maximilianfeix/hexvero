{
  "name": "@hexvero/core",
  "version": "0.10.1",
  "description": "Zero-dependency static parsers behind hexvero, the Electron release diff: app.asar, JavaScript bundles, IPC and contextBridge, plus ELF, PE, Mach-O, APK and more. Never runs what it reads.",
  "keywords": [
    "asar",
    "diff",
    "electron",
    "hexvero",
    "ipc",
    "reverse-engineering",
    "static-analysis"
  ],
  "homepage": "https://github.com/maximilianfeix/hexvero#readme",
  "bugs": {
    "url": "https://github.com/maximilianfeix/hexvero/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/hexvero.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "ghidra"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
