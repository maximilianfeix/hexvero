{
  "name": "hexvero-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "hexvero.dev — reverse engineer anything, locally.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/core packages/mcp packages/cli",
    "lint": "oxlint packages --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.5.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
