{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "package-lock.json",
    "examples/*.js",
    "examples/*.asar",
    "corpus/dev/*/src/**",
    "corpus/validation/*/src/**",
    "corpus/built/**",
    "corpus/results/**",
    "corpus/holdout/*/src/**",
    "corpus/holdout/verify/**",
    "corpus/holdout2/*/src/**",
    "corpus/holdout2/verify/**",
    "corpus/holdout3/*/src/**",
    "corpus/holdout4/*/src/**",
    "corpus/compare/**",
    "site/demo/**",
    "docs/launch/published/**",
    "packages/core/test/fixtures/sarif-schema-2.1.0.json",
    "docs/case-studies/*.report.md",
    "docs/case-studies/*.report.html",
    "corpus/holdout5/*/src/**",
    "corpus/holdout6/*/src/**",
    "corpus/holdout7/*/src/**"
  ]
}
